# App settings for development; `make app-init` and the production compose switch them to production/release.
GIN_MODE=debug
APP_NAME=jungo
API_SERVER_PORT=8080
API_ENVIRONMENT=development
API_VERSION=v0.1.0
API_COMMIT=local
API_LANGUAGE=en
API_TIMEZONE=UTC

# Login: secret keys (set by `make app-init`; changing them logs everyone out), token TTLs, brute-force limits.
AUTH_TOKEN_HMAC_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_INTERNAL_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SESSION_CACHE_TTL=3m
AUTH_PERMISSION_CACHE_TTL=60s
AUTH_REVOKED_RETENTION=168h
AUTH_PASSWORD_COST=10
AUTH_RECAPTCHA_ON_LOGIN=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_BLOCK_WINDOW=15m
AUTH_LOGIN_BLACKLIST_ATTEMPTS=8
AUTH_LOGIN_BLACKLIST_WINDOW=24h

# Password reset (needs MAIL_*): RESET_URL = frontend page reading ?token= (empty = off); IP/EMAIL_MAX requests per WINDOW.
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
AUTH_PASSWORD_RESET_TTL=30m
AUTH_PASSWORD_RESET_WINDOW=1h
AUTH_PASSWORD_RESET_IP_MAX=5
AUTH_PASSWORD_RESET_EMAIL_MAX=3

# Optional container CPU/memory limits.
# APP_MEM_LIMIT=1024M
# APP_CPU_LIMIT=2.0
# APP_GOMEMLIMIT=900MiB

# Debug dashboard: add ?t_debug=<value> and header X-Internal-Secret. Empty = off.
TRACER_DEBUG_KEY=t_debug
TRACER_DEBUG_VALUE=

# PostgreSQL connection and pool.
DB_HOST=postgresql
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jungo
DB_SSLMODE=disable
DB_MAX_CONNECTION=10
DB_MIN_CONNECTION=5
DB_QUERY_LOGGING=true
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=10m
DB_HEALTH_CHECK_PERIOD=1m
DB_SLOW_QUERY_THRESHOLD=200ms
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_TIMEOUT=60s
DB_CONNECT_TIMEOUT=5s

# CORS: websites allowed to call the API; list them in production, never * with CORS_ALLOW_CREDENTIALS=true.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Device-ID
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400

# Log levels per channel and rotation. Log files go to $STORAGE_DIR/logs.
LOG_APP_LEVEL=debug
LOG_HTTP_LEVEL=info
LOG_SQL_LEVEL=info
LOG_LIMITER_LEVEL=info
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=7
LOG_COMPRESS=true

# Everything the app writes (logs/, uploads/, bootstrap/) lives here.
STORAGE_DIR=./storage

# Rate limit per client: requests per second, plus burst.
LIMITER_RPS=10
LIMITER_BURST=30
LIMITER_SHARDS=64
LIMITER_CLEANUP_INTERVAL=1m
LIMITER_CLIENT_TTL=3m
LIMITER_LOG_TTL=30s
LIMITER_IP_WHITELIST=

# Ban scanners (probe paths, attack URLs, scanner UAs, or MAX_STRIKES 4xx per STRIKE_WINDOW); repeats escalate via BAN_DURATIONS.
BANNER_ENABLED=true
BANNER_MAX_STRIKES=30
BANNER_STRIKE_WINDOW=1m
BANNER_BAN_DURATIONS=15m,1h,24h

# Max request body in bytes (2 MB). Upload routes set their own limit in code.
SECURITY_MAX_BODY_SIZE=2097152

# Proxy IPs/CIDRs to read the real client IP; required behind a proxy, else all clients share its IP and its limits.
SECURITY_TRUSTED_PROXIES=

# Send Strict-Transport-Security even over plain HTTP; set true when a TLS-terminating proxy is in front.
SECURITY_FORCE_HSTS=false

# Redis cache for sessions/permissions (off = read from DB each request); set true and run `make app-dev WITH=cache`.
CACHE_REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Uploads: public URL (empty = http://localhost:<port>/uploads); files go to $STORAGE_DIR/uploads.
STORAGE_BASE_URL=

# Telegram alerts: off while empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: MAIL_DRIVER=log (dev only, writes emails to the log), smtp or brevo (needs MAIL_BREVO_API_KEY).
MAIL_DRIVER=log
MAIL_FROM=Jungo <no-reply@example.com>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# SMTP requires TLS; true only for a local server without it (Mailpit: make app-dev WITH=mail).
MAIL_SMTP_ALLOW_PLAINTEXT=false
MAIL_BREVO_API_KEY=

# reCAPTCHA: mock always passes, in development only.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_MOCK=true
